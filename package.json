{
  "name": "@itamarrocha/session-bridge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Connect running Codex and Claude Code sessions through supported local interfaces.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "session-bridge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItamarRocha/session-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/ItamarRocha/session-bridge/issues"
  },
  "homepage": "https://github.com/ItamarRocha/session-bridge#readme"
}
